# Copy this file to .env and change values locally.
# Do not commit real passwords to Git.

POSTGRES_DB=normalizer_audit
POSTGRES_USER=normalizer_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=C:/absolute/path/to/normalizer/pgdata/data

ADMINER_PORT=8081
ADMINER_DEFAULT_SERVER=postgres
APP_PORT=8082
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

EQUIPMENT_POLLING_ENABLED=false
ASUTP_ENABLED=false

# Optional local AuthAnswerMock / OuterAnswerMock integration.
# For a mock running on Windows localhost:9090, copy these values to .env.
OUTER_ANSWER_URL=http://host.docker.internal:9090/api/events
EQUIPMENT_POLLING_URL=http://host.docker.internal:9090/api/equipment/polling
EQUIPMENT_POLLING_INTERVAL=10
ASUTP_URL_1=http://host.docker.internal:9090/api/asutp/auth
ASUTP_URL_2=http://host.docker.internal:9090/api/asutp/context
ASUTP_URL_3=http://host.docker.internal:9090/api/asutp/data
ASUTP_DOMAIN_NAME=normalizer-test
ASUTP_PASSWORD=normalizer-test-password
ASUTP_CAST_HOUSE_ID=1
ASUTP_TAG_IDS=gate,tilt
ASUTP_GATE_TAGS=1=gate
ASUTP_TILT_TAGS=1=tilt
ASUTP_CONTEXT_TOKEN_MODE=raw
ASUTP_DATA_TOKEN_MODE=raw
